// Module map for the Llama SwiftPM target (steven-moon/llama.cpp fork).
//
// llama.h textually includes ggml.h. Forwarding headers in `include/` route
// SwiftPM's single public header directory to ggml's canonical declarations,
// exposing both C surfaces without compiling independent header copies.
//
// Consumers import this as `import Llama`.

module Llama {
    header "ggml.h"
    header "ggml-alloc.h"
    header "ggml-backend.h"
    header "ggml-cpu.h"
    header "ggml-opt.h"
    header "gguf.h"
    header "llama.h"
    export *
}
